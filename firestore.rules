rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "temo75elia@gmail.com";
    }

    match /users/{userId} {
      // Users must be able to read their own profile so the app can
      // distinguish a real blocked flag from a Firestore permission error.
      // Blocked users still cannot update their profile (see update rule).
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == userId);

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.blocked != true;

      allow update: if (
          request.auth != null
          && request.auth.uid == userId
          && resource.data.blocked != true
          && request.resource.data.blocked != true
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['blocked', 'blockedAt', 'blockedBy', 'records', 'settings', 'profileDeleted'])
        );

      allow delete: if isAdmin();
    }
  }
}
